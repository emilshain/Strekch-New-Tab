{
  "manifest_version": 3,
  "name": "Minimalist Digital Clock",
  "version": "1.1",
  "description": "A premium, minimalist new tab extension with a digital clock and weather.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "geolocation"
  ]
}
